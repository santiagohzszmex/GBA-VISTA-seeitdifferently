{
  "name": "gba-vista",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:network": "node tests/network-pilot.mjs",
    "test:publishing": "node tests/publishing.test.mjs",
    "test:survey": "node tests/survey.test.mjs",
    "test:social": "node tests/social.test.mjs",
    "test:studios": "node tests/studios.test.mjs",
    "test:session": "node tests/session.test.mjs",
    "test:home": "node tests/home.test.mjs",
    "test:recruitment": "node tests/recruitment.test.mjs",
    "test:workspace": "node tests/workspace.test.mjs && node tests/identity-gateway.test.mjs",
    "workspace:dev": "vite --config vite.workspace.config.js",
    "workspace:build": "vite build --config vite.workspace.config.js",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/workspace-build.mjs",
    "test:desktop": "node tests/license-clock.test.mjs && node tests/desktop-config.test.mjs && node tests/native-paths.test.mjs && node tests/native-build.test.mjs && node tests/release-manifest.test.mjs && node tests/manual-updates.test.mjs && node tests/update-manifest.test.mjs",
    "desktop:publish": "node scripts/workspace-publish-update.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.2",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.344.0",
    "micromark": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tauri-apps/cli": "2.8.4",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  }
