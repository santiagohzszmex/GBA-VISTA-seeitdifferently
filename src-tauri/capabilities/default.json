{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Workspace con comprobaci\u00f3n y actualizaci\u00f3n firmada; sin acceso general al sistema de archivos ni shell; abre s\u00f3lo enlaces de asignaci\u00f3n de Ultramar",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://gba.software/workspace/web/?device-notifications=1"
        },
        {
          "url": "ultramar://workspace/asignacion/*"
        }
      ]
    }
  ]
}
