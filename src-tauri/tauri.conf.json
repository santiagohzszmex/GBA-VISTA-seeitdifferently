    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://gba.software https://www.gba.software https://vista.gba.software; frame-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
